# ============================================================
# PUBLIC APPLICATION
# ============================================================

NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ============================================================
# DATABASE — NEON POSTGRESQL
# ============================================================

# Runtime connection.
# Use the pooled Neon connection string.
# Server-only.
DATABASE_URL=

# Migration / administrative connection.
# Use the direct Neon connection string.
# Server-only.
DATABASE_URL_DIRECT=


# ============================================================
# ADMIN AUTHENTICATION
# ============================================================

# High-entropy secret used to HMAC session tokens and
# privacy-preserving login-throttling identifiers.
#
# Generate a value locally using:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
#
# Server-only.
AUTH_SESSION_SECRET=


